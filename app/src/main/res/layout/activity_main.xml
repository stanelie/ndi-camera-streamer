<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.exmachina.ndicamerastreamer.AspectRatioSurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:background="#80000000"
        android:text="Starting..." />

    <!-- Hidden unless the NDI Advanced SDK's trial-license message is seen on its stdout (see
         NdiSender.warningListener) — makes an otherwise-silent "stream stopped reaching
         receivers" failure legible as a licensing issue instead of looking like a network
         problem. -->
    <TextView
        android:id="@+id/trialWarningBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:padding="10dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#DDAA0000"
        android:visibility="gone" />

    <!-- Focus mode: upper-right, away from the lower half where tap-to-focus is most likely
         to be aimed. -->
    <Button
        android:id="@+id/focusModeButton"
        android:layout_width="128dp"
        android:layout_height="72dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:text="AF"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#80000000"
        android:padding="0dp" />

    <!-- Lock: lower-right, away from the focus button and out of the way of tap-to-focus. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="8dp"
        android:orientation="vertical"
        android:gravity="end">

        <Button
            android:id="@+id/lockButton"
            android:layout_width="128dp"
            android:layout_height="72dp"
            android:text="LOCK"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#CC224488"
            android:padding="0dp" />

        <TextView
            android:id="@+id/lockedBadge"
            android:layout_width="128dp"
            android:layout_height="72dp"
            android:gravity="center"
            android:text="LOCKED"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#CC992222"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
